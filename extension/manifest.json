{
  "manifest_version": 3,
  "name": "agy browser bridge",
  "version": "0.1.0",
  "description": "Lets the agy-browser MCP server drive this Chrome through chrome.debugger.",
  "permissions": ["debugger", "tabs", "tabGroups", "scripting", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "agy browser bridge",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
